// r04: flute staccato from VSCO 2 Community Edition (CC0), LDFlute stac samples (10, one per major third), as shipped
// in the Virtual Playing Orchestra 3.2 wave archive (libs/VSCO2-CE/Woodwinds/Flute/stac-PB). Written for sfzplay.py
// by actor 4. The file names are one octave below MIDI convention (C3 = MIDI 60, checked by pitch detection).
// The recorded note plays out (one-shot); velocity is gain only.
<group>
ampeg_attack=0.001 ampeg_release=0.25 amp_veltrack=100 loop_mode=one_shot
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_C3-PB.wav lokey=55 hikey=62 pitch_keycenter=60
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_E3-PB.wav lokey=63 hikey=66 pitch_keycenter=64
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_A3_v2_rr1-PB.wav lokey=67 hikey=70 pitch_keycenter=69
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_C4_v4_rr1-PB.wav lokey=71 hikey=74 pitch_keycenter=72
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_E4_v2_rr1-PB.wav lokey=75 hikey=78 pitch_keycenter=76
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_A4_v3_rr2-PB.wav lokey=79 hikey=82 pitch_keycenter=81
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_C5_v1_rr1-PB.wav lokey=83 hikey=86 pitch_keycenter=84
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_E5_v1_rr2-PB.wav lokey=87 hikey=90 pitch_keycenter=88
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_A5_v1_rr1-PB.wav lokey=91 hikey=94 pitch_keycenter=93
<region> sample=../../assets/vpo3/libs/VSCO2-CE/Woodwinds/Flute/stac-PB/LDFlute_stac_C6_v2_rr2-PB.wav lokey=95 hikey=100 pitch_keycenter=96
