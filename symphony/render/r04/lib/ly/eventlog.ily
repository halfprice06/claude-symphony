% Event logger: a Voice engraver that writes every note, articulation, slur, tremolo, text and
% dynamic event to events.tsv (in the current directory) with its staff, voice and score position.
% Used by tools/score_events.py on a scratch copy of the score; prints nothing.
#(define evlog-port (open-output-file "events.tsv"))
#(define (evlog-str x)
   (cond ((string? x) x)
         ((symbol? x) (symbol->string x))
         ((markup? x) (markup->string x))
         (else (format #f "~a" x))))
#(define (evlog-desc e)
   (cond ((ly:in-event-class? e 'tremolo-event) (format #f "tremolo~a" (ly:event-property e 'tremolo-type)))
         ((ly:in-event-class? e 'phrasing-slur-event) (format #f "pslur~a" (ly:event-property e 'span-direction)))
         ((ly:in-event-class? e 'slur-event) (format #f "slur~a" (ly:event-property e 'span-direction)))
         ((ly:in-event-class? e 'tie-event) "tie")
         ((ly:in-event-class? e 'absolute-dynamic-event) (format #f "dyn:~a" (evlog-str (ly:event-property e 'text))))
         ((ly:in-event-class? e 'crescendo-event) (format #f "cresc~a" (ly:event-property e 'span-direction)))
         ((ly:in-event-class? e 'decrescendo-event) (format #f "decresc~a" (ly:event-property e 'span-direction)))
         ((ly:in-event-class? e 'text-script-event) (format #f "text:~a" (evlog-str (ly:event-property e 'text))))
         ((ly:in-event-class? e 'articulation-event) (format #f "art:~a" (evlog-str (ly:event-property e 'articulation-type))))
         (else (format #f "other:~a" (car (ly:event-property e 'class '(unknown)))))))
#(define (evlog kind ctx e)
   (let* ((mom (ly:context-current-moment ctx))
          (staff (ly:context-find ctx 'Staff))
          (sid (if staff (ly:context-id staff) "?"))
          (vid (ly:context-id ctx))
          (dur (ly:event-property e 'duration #f))
          (pit (ly:event-property e 'pitch #f))
          (arts (ly:event-property e 'articulations '())))
     (format evlog-port "~a\t~a\t~a\t~a\t~a\t~a\t~a\t~a\n"
             kind sid vid
             (exact->inexact (ly:moment-main mom))
             (exact->inexact (ly:moment-grace mom))
             (if dur (exact->inexact (ly:moment-main (ly:duration-length dur))) "")
             (if pit (+ 60 (ly:pitch-semitones pit)) "")
             (if (eq? kind 'note)
                 (string-join (map evlog-desc (filter ly:stream-event? arts)) ",")
                 (evlog-desc e)))))
#(define (evlog-engraver context)
   (make-engraver
    (listeners
     ((note-event engraver event) (evlog 'note context event))
     ((articulation-event engraver event) (evlog 'post context event))
     ((slur-event engraver event) (evlog 'post context event))
     ((phrasing-slur-event engraver event) (evlog 'post context event))
     ((tremolo-event engraver event) (evlog 'post context event))
     ((text-script-event engraver event) (evlog 'post context event))
     ((absolute-dynamic-event engraver event) (evlog 'post context event))
     ((crescendo-event engraver event) (evlog 'post context event))
     ((decrescendo-event engraver event) (evlog 'post context event))
     ((tie-event engraver event) (evlog 'post context event)))))
\layout { \context { \Voice \consists #evlog-engraver } }
