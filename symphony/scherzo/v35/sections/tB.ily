tBHarpR = { r4 <gis cis' e'>4 <gis cis' e'>4 | r4 <gis cis' e'>4 <gis cis' e'>4 | r4 <a cis' fis'>4 <a cis' fis'>4 | r4_\markup \small "C♮" <gis c' dis'>4 <gis c' dis'>4 | r4 <b' dis'' fis''>4 <b' dis'' fis''>4 | r4 <b' dis'' fis''>4_\markup \small "C♯ A♯" <b' dis'' fis''>4 | r4 <gis' b' e''>4 <gis' b' e''>4 | r4 <ais' cis'' fis''>4 <ais' cis'' fis''>4 | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | }
