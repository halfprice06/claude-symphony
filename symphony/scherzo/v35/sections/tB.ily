tBHnFour = { R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | cis'2.\p | c'2. | b2.\> | b2. | b2.\! | b2. | b2.\< | b2. | }
tBTimp = { R2. | R2. | R2. | gis,4\pp r4 r4 | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | gis,4\f r4 r4 | R2. | R2. | R2. | R2. | b,2.:32\pp | b,2.:32 | b,2.:32\< | b,4\mf r4 r4 | }
