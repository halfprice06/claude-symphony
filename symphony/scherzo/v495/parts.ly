% c165: Vln I an octave lower, for cues whose source would sit four or more ledger lines above the reader's stave (C.a. 41, Hn 2 37, harp 337; MOLA PDF 5, Adler PDF 299-300); labelled "(8vb)". c385: those cues now quote the instrument at pitch under a real octave sign (Hn 2 37, harp 337: 8va; Ob 1 181: Vc. under 8vb) or in their own clef (timpani 85/89, Vc 165: treble), Gould PDF 42-46
\addQuote "cueVlnOneLow" { \transpose c' c \vlnOne }
% c255: Cl. 1 an octave lower for the timpani's cue at 85-88 (the F-major episode's solo before the timpani's entry alone at 89, a tempo after the poco rit.;
%   at pitch it would sit four to five ledger lines above the bass stave; MOLA PDF 5, Ex. 4 PDF 10)
\addQuote "cueClOneLow" { \transpose c' c \clOne }
% c345: cellos an octave higher, for Ob 1's cue at 181-184: since c344 the trio tune's second statement (169-184) is in the cellos and Vln I rests,
%   so the old "Vln. I" cue printed an empty bar rest; at pitch the cellos' D sharp 3 would sit five ledger lines below the oboe's stave
\addQuote "cueVcHigh" { \transpose c c' \vc }
partGlobal = \partGlobalOf \global
% c250: MOLA PDF 5: "Numbering each measure should be avoided, except in the case of multi-measure rests, where measure number ranges
% are helpful (e.g., '27-117')". As movement I (v266) and movement II (v261): a rest of two or more bars prints its bar range, small,
% above the count. The range is read from the rest's bounding columns, so it follows the score's numbering.
#(define (mmr-range-stencil grob)
   (let* ((base (ly:text-interface::print grob))
          (lc (ly:spanner-bound grob LEFT)) (rc (ly:spanner-bound grob RIGHT))
          (ll (ly:grob-property lc 'rhythmic-location #f)) (rl (ly:grob-property rc 'rhythmic-location #f)))
     (if (and (ly:stencil? base) (pair? ll) (pair? rl) (> (- (car rl) (car ll)) 1))
         (ly:stencil-combine-at-edge (ly:stencil-aligned-to base X CENTER) Y UP
           (ly:stencil-aligned-to (grob-interpret-markup grob
             (markup #:fontsize -4 #:normal-text (format #f "~a–~a" (car ll) (- (car rl) 1)))) X CENTER) 0.3)
         base)))
\layout { \context { \Staff \override MultiMeasureRestNumber.stencil = #mmr-range-stencil } }
\layout {
  \context { \Score
    skipBars = ##t
    rehearsalMarkFormatter = #format-mark-box-letters
    \override RehearsalMark.font-size = #2
    \override MultiMeasureRest.expand-limit = #1
    \override MultiMeasureRest.minimum-length = #14
    \override SpacingSpanner.spacing-increment = #1.6
    \override MetronomeMark.padding = #1.5
    \override RehearsalMark.padding = #1.5
    \override Hairpin.minimum-length = #5
    \override Hairpin.springs-and-rods = #ly:spanner::set-spacing-rods
    \override MultiMeasureRestNumber.font-size = #0
    \override MetronomeMark.extra-spacing-width = #'(0 . 1.0)
    \override RehearsalMark.extra-spacing-width = #'(-0.5 . 0.5)
    \override MetronomeMark.extra-spacing-height = #'(4 . 4)
    \override RehearsalMark.extra-spacing-height = #'(4 . 4)
    \override MetronomeMark.outside-staff-horizontal-padding = #1.5 % c345: a tempo word that ends less than a word space before the next one is stacked, not run on (harp 89/101)
    \override RehearsalMark.outside-staff-horizontal-padding = #1.5
  }
  \context { \Staff \consists "Page_turn_engraver" }
  \context { \Score minimumPageTurnLength = #(ly:make-moment 15/4) } % five bars of 3/4: about 3.4 s at 2. = 88, 3.9 s at 2. = 76 (MOLA PDF 7: consider the tempo)
  \context { \Voice \consists #middleLineStemEngraver \remove "Dynamic_engraver" \remove "Dynamic_align_engraver" \override Beam.positions = #gould-ledger-beam-positions }
  \context { \Staff \consists "Dynamic_engraver" \consists "Dynamic_align_engraver" }
}

