\book {
  \bookOutputSuffix "25-harp"
  \header { instrument = "Harp" }
  % Cover page (MOLA PDF 6: needed "when pagination requires the music to begin on page two in order to accommodate page
  % turns"). Without it the one turn fell at 184-185, inside the trio's unbroken left-hand crotchets (169-208); now the music
  % is on pages 2-3, a facing pair, and needs no turn.
  % The harpist turns in the 96-bar rest 241-336 (forced \pageBreak at 241): pages 2-3 (a facing pair) hold 1-240, page 4 holds 241-376.
  % ly:page-turn-breaking took the right hand's rests for turns although the left hand plays (184/185, 224/225).
  \paper { bookTitleMarkup = ##f page-breaking = #ly:optimal-breaking }
  \markup \column {
    \vspace #12
    \fill-line { \center-column {
      \fontsize #6 \bold "Symphony No. 1 in C minor"
      \vspace #1
      \fontsize #3 "III. Scherzo"
      \vspace #4
      \fontsize #5 \bold "Harp"
    } }
  }
  \pageBreak
  \score {
    \new PianoStaff = "part" <<
      \new Staff = "Harp RH" \with { \audit "25-harp-rh" } << \partGlobal \partCues #`(("cueVlnOne" "Vln. I" ,UP 69 4) ("cueHnOne" "Hn. 1" ,UP 145 4) ("cueVlnOne" "Vln. I" ,UP 337 3 "8va@7")) \partCleanHarp \harpR { \skip 2.*240 \pageBreak } >>
      \new Staff = "Harp LH" \with { \audit "25-harp-lh" \override DynamicText.direction = #UP \override DynamicLineSpanner.direction = #UP } << \clef bass \partGlobal \partCleanHarp \harpL >>
    >>
    \layout { }
  }
}
