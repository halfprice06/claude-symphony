tCVla = { r4 <b e'>4--(\mf^\markup \italic "div." <b e'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a dis'>4--( <a dis'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a e'>4--( <a e'>4--) | r4 <a fis'>4--( <a fis'>4--) | r4 <ais e'>4--( <ais e'>4--) | r4 <b dis'>4--( <b dis'>4--) | r4 <gis e'>4--( <gis e'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a cis'>4--( <a cis'>4--) | r4 <a fis'>4--( <a fis'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a dis'>4--( <a dis'>4--) | r4 <gis e'>4--(\> <gis e'>4--) | r4 <gis e'>4--( <gis e'>4--) | gis'2.\pp^\markup \italic "unis." | gis'2. | e'2. | gis'2. | gis'2. | gis'2. | e'2. | gis'2. | gis'2. | gis'2. | e'2. | gis'2. | gis'2.~ | gis'2.~ | gis'2.~ | gis'2 r4 | }
