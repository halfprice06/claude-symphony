dAFluteOne = { R2.*8 | a'''8(\p^\markup \italic "leggiero"^\markup \bold "1." g''' a''' g''' fis'''4) | e'''8( fis''' e''' dis''' e'''4) | fis'''8(\< g''' a''' g''' fis''' e''') | c'''2-\tweak stencil ##f \mp\>( b''8 fis''8) | e'''4-.-\tweak stencil ##f \p b''8-. b''-. e'''4-. | g'''8( a''' g'''4 fis'''8 f''') | e'''8( dis''' e''' fis''' dis'''4) | e'''4-. r4 r4 | R2. | R2. | R2. | R2. | a''4-.\f d''8-. d''-. a''4-. | c'''2->( b''8 bes''8 | a''4-.) fis''8-. fis''-. d''4-. | \transpose d b, { a''4-. r4 r4 } | b''4.->\subP(^\markup \italic "espress." a''8 gis''4~ | gis''4 e'''2) | dis'''2( cis'''4~ | cis'''4 b''4. d'''8) | R2.*4 | b''4\f( cis'''8 b'' a''4 | g''!2\< fis''4~ | fis''4-\tweak stencil ##f \ff\> e''2-\tweak stencil ##f \f) | e''4-. r4 r4 | }
