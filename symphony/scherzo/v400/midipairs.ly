\version "2.24.0"
\language "nederlands"
% c075: instrumental parts for the scherzo (MOLA Guidelines PDF 5-8), generated by parts-gen.py from the same single-player
% variables as the score (parts.ily). Build after build.sh:  bash build-parts.sh <version-dir>
\header {
  title = "Symphony No. 1 in C minor"
  subtitle = "III. Scherzo"
  tagline = ##f
}
#(set-global-staff-size 20.5) % 7.2 mm staff (MOLA PDF 7: 7.0-7.5 mm for parts)
\paper {
  paper-width = 257\mm   % B4 (JIS), "the most common size" for parts (MOLA PDF 8)
  paper-height = 364\mm
  top-margin = 15\mm
  bottom-margin = 20\mm
  left-margin = 20\mm
  right-margin = 20\mm
  ragged-last-bottom = ##t
  max-systems-per-page = 12 % MOLA PDF 7
  page-breaking = #ly:page-turn-breaking % MOLA PDF 7: page turns in rests
  print-first-page-number = ##t
}
sec = #(define-music-function (name bars beats) (string? integer? integer?)
  (let ((v (ly:parser-lookup (string->symbol name))))
    (if (ly:music? v) v
        (make-music 'MultiMeasureRestMusic 'duration (ly:make-duration 2 0 (* bars beats))))))
secDrum = #(define-music-function (name bars beats) (string? integer? integer?)
  (let ((v (ly:parser-lookup (string->symbol name))))
    (if (ly:music? v) v
        (make-music 'MultiMeasureRestMusic 'duration (ly:make-duration 2 0 (* bars beats))))))
\include "global.ily"
\include "sections/intro.ily"
\include "sections/sA.ily"
