dCOboeTwo = { \partCombineApart e''4-. r4 \tag #'score \once \override Rest.staff-position = #-6 r4 | \partCombineSoloI R2.*15 | \partCombineAutomatic R2. | R2.*3 | }
% c021: cor anglais doubles Cl 2's lower octave of theme A, as at 105
% c224: 321-323 C.a. B4 (was B3), as 133-136 (Adler II PDF 159; I PDF 198, 205); it releases on beat 3 of 323, as the cellos' G2 enters, so the held B4 does not
%   stand as the top voice over the bass's E2 -> B1 into 324 (the analyser read that as fifths B4/E2 -> F#2/B1).
% c288: 321-323 fading wind chord slurred with tenuto, as 133-136 (see sC.ily; Adler I PDF 309, 321).
dCCorAnglais = { e'4-. b8-. b-. e'4-. | g'2->( fis'8 f'8 | e'4-.) b'8-. b'-. g'4-. | fis'4-. dis'-. b-. | e'4-. b8-. b-. e'4-. | a'2->( gis'8 g'8 | fis'4-.) dis'8-. dis'-. b4-. | e'4-. r4 r4 | a'4-. g'-. fis'-. | e'4-. dis'8-. dis'-. e'4-. | fis'4-.( g'8 a'8) b'4-. | c''2->( b'8 fis'8) | e'4-. b8-. b-. e'4-. | g'2->( fis'8 f'8 | e'4-.) dis'8-. dis'-. fis'4-. | e'4-. r4 r4 | g'2.--(\p | g'2.--\> | g'2.--)\! | R2. | }
