dCClTwo = { \partCombineApart e'4-. b8-. b-. e'4-. | \partCombineSoloII g'2->( fis'8 f'8 | e'4-.) b'8-. b'-. g'4-. | fis'4-. dis'-. b-. | e'4-. b8-. b-. e'4-. | a'2->( gis'8 g'8 | fis'4-.) dis'8-. dis'-. b4-. | e'4-\sysLabel "2."-. r4 r4 | a'4-. g'-. fis'-. | e'4-. dis'8-. dis'-. e'4-. | fis'4-.( g'8 a'8) b'4-. | c''2->( b'8 fis'8) | e'4-. b8-. b-. e'4-. | g'2->( fis'8 f'8 | e'4-.) dis'8-. dis'-. fis'4-. | e'4-. r4 r4 | \partCombineAutomatic e'2.--(\p | e'2.-- | e'2.--)\> | R2.\! | }
