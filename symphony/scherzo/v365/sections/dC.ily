dCVc = { g2.^\markup \italic "espress." | b2( e'4~ | e'2 b4) | a2( fis4 | g2.) | a2( c'4\<~ | c'4-\tweak stencil ##f \fff\> b4-\tweak stencil ##f \ff a4) | g2. | c'2. | b2. | a2( c'4 | b2 a4) | g2 e'4~ | e'2 g4 | a2( fis4 | g4) r4 r4 | e4-.\f b,8-. b,-. e4-. | R2. | e4-.\mf\> b,8-. b,-. g,4-. | fis,4-. dis,-. b,-.\! | }
dCCb = { e,,4-- r4 r4 | e,,4-- r4 r4 | e,,4-- r4 r4 | b,,4-- r4 r4 | e,,4-- r4 r4 | a,,4-- r4 r4 | b,,4-- r4 r4 | e,,4-- r4 r4 | fis,,4-- r4 r4 | g,,4-- r4 r4 | a,,4-- r4 r4 | b,,4-- r4 r4 | e,,4-- r4 r4 | g,,4-- r4 r4 | b,,4-- r4 r4 | e,,4-- r4 r4 | e,,4-.\f r4 r4 | R2. | e,,4-.\mf r4 r4 | b,,4-. r4 r4 | }% c112: 310-311 tenor C4 tied over the bar (as sC 110-111; A-S Ex. 12-21, PDF 190). 308 violas B3.
% c205: 305 Ob 2 rests at one height, as sC 105.
