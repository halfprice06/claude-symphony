% TRIO, first part, bars 153-184 (E major, un poco meno mosso).
% c035: 169 Fl 1 prints "1." (no label was reprinted after the shared rest).
% 153-168: the trio tune T in Cl 1, dolce, over the harp's off-beat chords and a soft E-B drone in Hn 3-4 (a musette).
%   T is new material: it rises by step and a fourth (G sharp-A-B-E) and falls back through D sharp, the leading tone (cyclic-notes:
%   the scherzo prepares D sharp as a spelling for the finale's violas). Cadences: half 160, authentic 167.
% 169-184: T in Vln I, an octave higher; Fl 1 doubles it heterophonically (the same line with passing notes and turns: still unused in I and II);
%   the cellos have a countermelody of their own (a melodic bass line), the double basses pizzicato.

% c036: Fl 1 p, not pp: its line climbs to A6, the flute's top fourth, where soft dynamics and intonation are hardest to control (Adler PDF 174, 186)
% c051: 169-176 Fl 1 rests: its heterophony sat at the violins' pitch and shadowed T note for note (Sebesky PDF 211-212, Ex. 279-280: a background that
%   shadows the solo in near-parallel motion distorts the focus); it joins at 177 for the climb to A6, the added colour saved for the climax (PDF 209).
% c051: 172, 176 (and 212, 216 in tC) the cellos' countermelody moves on beat 3 where T holds, carrying the phrase into the next (Sebesky PDF 207-208, Ex. 273).
% c061: 166, 182 (and 222 in tC, 355 in the coda) T's cadence takes a real V4-3 suspension: the E of the cadential 6/4 is tied over the barline
%   and resolves to D sharp on beat 2 (was D sharp minim on the downbeat). Aldwell-Schachter Unit 21 PDF 352 sec. 8 (the cadential suspension
%   emphasizes the leading tone), PDF 346 sec. 1 (a suspension animates and individualizes a line through rhythm), PDF 348 (dissonant suspensions
%   take an accent, their resolutions are softer). No other part has D sharp on the downbeat (harp and violas enter on beat 2: PDF 352 sec. 12);
%   182 Fl 1 E6 with the violins on beat 1, its turn moved to beat 2 (it had D sharp 6 against the violins' E6).
tAFluteOne = { R2.*16 | R2.*8 | cis'''4(\p\<^\markup \bold "1." b''8 cis''' dis'''4) | e'''4( fis'''8 e''' gis'''4) | a'''4.(\> gis'''8 fis'''4) | cis'''4( b'' a'') | gis''4\!( b'' e'''~ | e'''4 dis'''8 e''' fis'''4) | e'''2.~ | e'''2 r4 | }
tAClOne = { gis'2(\p^\markup \italic "dolce" a'4 | b'2 e''4 | dis''4. cis''8 b'4 | a'4 gis'2) | a'2( b'4 | cis''2 fis''4 | e''4. dis''8 cis''4 | ais'4 b'2) | cis''2(\< dis''4 | e''4 gis''2 | a''4.\> gis''8 fis''4 | cis''4 b'4 a'4) | gis'4\!( b'4 e''4~ | e''4 dis''4 fis''4 | e''2.~ | e''2) r4 | R2.*16 | }
tAHnThree = { b2.~\pp | b2.~ | b2.~ | b2 r4 | b2.~ | b2.~ | b2.~ | b2 r4 | b2.~ | b2.~ | b2.~ | b2 r4 | b2.~ | b2.~ | b2.~ | b2 r4 | R2.*16 | }
tAHnFour = { e2.~\pp | e2.~ | e2.~ | e2 r4 | e2.~ | e2.~ | e2.~ | e2 r4 | e2.~ | e2.~ | e2.~ | e2 r4 | e2.~ | e2.~ | e2.~ | e2 r4 | R2.*16 | }
tATimp = { e,4\pp r4 r4 | R2.*3 | R2.*11 | e,4\pp r4 r4 | R2.*16 | }  % c055: pp restated at 168 after 14 bars rest (Adler II PDF 299, item 4); "soft sticks" moved to 146
tAHarpR = { r4 <gis b e'>4 <gis b e'>4 | r4 <gis b e'>4 <gis b e'>4 | r4 <a b dis'>4 <a b dis'>4 | r4 <gis b e'>4 <gis b e'>4 | r4 <a cis' e'>4 <a cis' e'>4 | r4 <a cis' fis'>4 <a cis' fis'>4 | r4 <cis' e' fis'>4 <cis' e' fis'>4 | r4 <b dis' fis'>4 <b dis' fis'>4 | r4 <gis cis' e'>4 <gis cis' e'>4 | r4 <gis b e'>4 <gis b e'>4 | r4 <a cis' fis'>4 <a cis' fis'>4 | r4 <a cis' fis'>4 <a cis' fis'>4 | r4 <gis b e'>4 <gis b e'>4 | r4 <a b dis'>4 <a b dis'>4 | r4 <gis b e'>4 <gis b e'>4 | r4 <gis b e'>4 <gis b e'>4 | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | R2. | }
tAHarpL = { e,4\p r4 r4 | e,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | a,,4 r4 r4 | fis,,4 r4 r4 | fis,,4 r4 r4 | b,,4 r4 r4 | cis,4 r4 r4 | gis,,4 r4 r4 | fis,,4 r4 r4 | a,,4 r4 r4 | b,,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | a,,4 r4 r4 | fis,,4 r4 r4 | fis,,4 r4 r4 | b,,4 r4 r4 | cis,4 r4 r4 | gis,,4 r4 r4 | fis,,4 r4 r4 | a,,4 r4 r4 | b,,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | }
tAVlnOne = { R2.*16 | gis''2(\mp^\markup \italic "espress., sul A" a''4 | b''2 e'''4) | dis'''4.( cis'''8 b''4) | a''4( gis''2) | a''2(^\markup \italic "nat." b''4 | cis'''2 fis'''4) | e'''4.( dis'''8 cis'''4) | ais''4( b''2) | cis'''2(\< dis'''4 | e'''4 gis'''2) | a'''4.(\> gis'''8 fis'''4) | cis'''4( b''4 a''4) | gis''4\!( b''4 e'''4~ | e'''4 dis'''4 fis'''4) | e'''2.~ | e'''2 r4 | }  % c031: 169-172 sul A, the E string from 173 (nat.) for the second phrase and the climb to A6 at 179 (Adler PDF 75: soft lyrical high notes on the A string, Brahms 3/iii)
tAVlnTwo = { R2.*16 | gis'2(\mp^\markup \italic "espress." a'4 | b'2 e''4) | dis''4.( cis''8 b'4) | a'4( gis'2) | a'2( b'4 | cis''2 fis''4) | e''4.( dis''8 cis''4) | ais'4( b'2) | cis''2(\< dis''4 | e''4 gis''2) | a''4.(\> gis''8 fis''4) | cis''4( b'4 a'4) | gis'4\!( b'4 e''4~ | e''4 dis''4 fis''4) | e''2.~ | e''2 r4 | }  % c011: T an octave under Vln I (Rimsky-Korsakov PDF 58-59, 62: a melody above the middle of the 5th octave is doubled an octave below)
tAVla = { R2.*16 | r4 <b e'>4--(\pp^\markup \italic "div." <b e'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a dis'>4--( <a dis'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a e'>4--( <a e'>4--) | r4 <a fis'>4--( <a fis'>4--) | r4 <ais e'>4--( <ais e'>4--) | r4 <b dis'>4--( <b dis'>4--) | r4 <gis e'>4--( <gis e'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a cis'>4--( <a cis'>4--) | r4 <a fis'>4--( <a fis'>4--) | r4 <b e'>4--( <b e'>4--) | r4 <a dis'>4--( <a dis'>4--) | r4 <gis e'>4--( <gis e'>4--) | r4 <gis e'>4--( <gis e'>4--) | }  % c011: violas div. take Vln II's off-beats, below the tune
% c037: 153-168 the cellos rest (they doubled the harp's left hand and the basses' pizzicato note for note), so their arco countermelody at 169
%   enters fresh and the musette under Cl 1 is lighter (Adler II PDF 228: Stravinsky lightens the texture so the next entrance is fresh;
%   PDF 205: the bass is the basses' pizzicato, the cello part is independent).
tAVc = { R2.*16 | b,4(\p^\markup \italic "arco" e2 | gis2.) | fis2( a4 | gis2 fis4) | e4( cis2~ | cis4 a,2) | ais,2( b,4 | dis2 fis4) | e4( gis2~ | gis4 e2) | a2( gis4 | fis2 cis4) | b,2( cis4 | a,4 b,2) | gis,2.~ | gis,2 r4 | }
tACb = { e,4\p r4 r4 | e,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | a,,4 r4 r4 | fis,,4 r4 r4 | fis,,4 r4 r4 | b,,4 r4 r4 | cis,4 r4 r4 | gis,,4 r4 r4 | fis,,4 r4 r4 | a,,4 r4 r4 | b,,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | e,4\p r4 r4 | e,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | a,,4 r4 r4 | fis,,4 r4 r4 | fis,,4 r4 r4 | b,,4 r4 r4 | cis,4 r4 r4 | gis,,4 r4 r4 | fis,,4 r4 r4 | a,,4 r4 r4 | b,,4 r4 r4 | b,,4 r4 r4 | e,4 r4 r4 | e,4 r4 r4 | }
