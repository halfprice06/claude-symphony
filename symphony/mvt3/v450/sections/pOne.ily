pOneCb = { es,2\f c,2 | d,2 f,,2 | g,,2 r4 g,,4 | b,,2 d,2 | c,2 g,,2 | f,2 d,2 | f,,2 fis,,2 | g,,2 g,,4 r4 | es,2 d,4 c,4 | bes,,2 f,,4 fis,,4 | g,,2 r4 g,,4 | b,,2 d,2 | c,2 f,2 | g,2 g,,2 | g,,2 g,,2 | aes,,2-> r2 | }
