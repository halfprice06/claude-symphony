pOneCbsn = { R1*8 | es,2\mf d,4 c,4 | bes,,2 f,,4 fis,,4 | g,,2 r4 g,,4 | b,,2 d,2 | c,2 f,2 | g,2 g,,2 | g,,2 g,,2 | aes,,2-> r2 | }
