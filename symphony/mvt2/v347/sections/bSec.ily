bSecTbnOne = {
  R1*23 | R1 |  % c069: trombone 1 rests 60-62 so its first sound in the movement is the quotation at 63 (Adler part 2 PDF 37: a colour held back for a specific event; PDF 156: a rest before a colour enters). Its A flat3/B flat3 go to horn 4. Trombone 2, bass trombone and tuba keep the c039 entry.
  \tag #'score { R1*2 } \tag #'part { \cueDuring #"bassTbnQ" #DOWN { <>^\markup \tiny "B.tbn." R1*2 } } |  % c075: cue in the part (MOLA PDF 5, Ex. 4)
  % c136: "solo" in the trombone 1 part: its first notes in the movement are the exposed quotation (Adler part 2 PDF 6: the trombone as soloist; the horn solos carry "solo" in their parts)
  r8 \shape #'((0 . 0) (0 . 0) (0 . 0) (-0.7 . -0.9)) Slur e8(\ff^\markup \italic "marcato"-\tag #'part ^\markup \italic "solo" c'4.->) b8( bes8 a8 | a4--) gis8( a8) f4.->\> e8\p |  % c240: falling B-B flat-A slurred into the repeated A, portato on it, as movement I's P head since its v239 (v251: tOne 'd''8( des''8 c''8 | c''4--) b'8( c''8)'); a quotation keeps its model's articulation (Sebesky PDF 241-242: older sounds recognised in new proportions)  % c218: the quotation's last note p (was mf), with the strings and bass trombone: in a diminuendo the brass leave first (Rimsky-Korsakov PDF 130), and a section does not end mf or mp (PDF 136)  % c148: pickup unaccented and slurred into the syncopated C4, turn slurred, as every ff statement of the P head in movement I (coda Hn 1 'r8 g8( es'4.->) ... b8( c'8) aes4.->', recOne, dev); an accented pickup weakens the syncopation (A&S PDF 51-52)  % c028: dim. after the last accent (Dvorak 9/ii Largo: the quotation steps ff to f; Adler part 2 PDF 503 sf > pp)
}
bSecTbnTwo = { R1*21 | \tag #'score { R1*2 } \tag #'part { \cueDuring #"vcQ" #UP { <>^\markup \tiny "Vc." R1*2 } } |  % c135: cue in the part before the entry after a long rest (MOLA PDF 5: logical, audible cues during long rests)
  es2\p\< ges2 \breathe |  % c132: E flat3 on 60 b1-2, the 7th G flat3 enters on b3 with the passing E flat-F-G flat of Bsn 1, Hn 1 and Vc, so the bass G natural of 59 is not followed by G flat in another voice (A&S PDF 377, 394)  % c346 (composer): low brass enter p, not pp, under the f orchestra at 60 (Adler part 1 PDF 319: pp is hard to control in the low register; A flat2 lies below the very strong register that starts at A2, PDF 329); c218 Rimsky rule allows the crescendo to start at p
   % c119: G flat3, the 7th of V7, resolving to F3 at 61; the low brass at 60 held only A flat and E flat (open fifths/octaves) under the strings' melody (Rimsky-Korsakov PDF 97 no. 4: wind middle parts in seconds, sevenths, thirds or sixths, no open fourths or fifths; PDF 100: brass in close order; Ex. 115, PDF 289: brass enter p with a complete chord)
  f2--\f-\tag #'score ^\markup \bold "2." aes2-- | bes2-- aes2-- | R1*2 | }  % c224: 62 b3 A flat3, the third of the F flat chord (was C flat4, its fifth, an octave under horns 3-4): thirds in the lower-middle register, fifths omitted from the brass voicing (Sebesky PDF 50, Ex. 53-54); the trombone section complete with the bass trombone and tuba's F flat (PDF 42); A flat3 = G sharp3 leads to the A minor of 63 (with the violas' A flat3)  % c218: f (was mf) with the horn pairs: paired horns need no extra degree (Rimsky-Korsakov PDF 41, 103), and the brass sits one degree under the ff woodwinds and strings, never two (PDF 112; appendix chords 2-3, PDF 505; Ex. 257, 261, 263: the trombones' crescendo from p/pp reaches the woodwinds' mark, PDF 130)  % c104: F3 on 61 b1-2 (E flat3-A flat3 from 60 made fifths with the bass, c099), then trombone 1's former middle line A flat3-B flat3-C flat4 (c069) an octave under horns 3-4: with trumpets and trombone 1 tacet the brass had an empty octave F3-F4 (61) and G flat3-G flat4 / A flat3-A flat4 (62) between the low brass and the horns (Rimsky-Korsakov PDF 100: brass in close order 'with no empty spaces'; PDF 101: 3rd trombone and tuba the bass in octaves, the upper parts to the other trombones reinforced by horns)
bSecBassTbn = { R1*21 | \tag #'score { R1*2 } \tag #'part { \cueDuring #"vcQ" #UP { <>^\markup \tiny "Vc." R1*2 } } |  % c135: cue in the part before the entry after a long rest (MOLA PDF 5: logical, audible cues during long rests)
  aes,1\p\< \breathe | des1--\f \breathe | ges,2-- fes,2-- \breathe | << a,1\sf\> \tag #'score { s4 \set Staff.midiExpression = #0.85 s4 \set Staff.midiExpression = #0.72 s4 \set Staff.midiExpression = #0.6 s4 \set Staff.midiExpression = #1.0 } >> | a,2\p d,4 e,4 | \tag #'part \break }  % c216: part-only line break after 64: the bass trombone's only notes (60-64) shared a line with the multi-bar rests to 92, so 61-64 were squeezed (G flat2-F flat2 at 62 against the A-minor naturals, D2-E2 at 64 against the 3/4 change, mf under the 62 notes) (Adler part 1 PDF 328-329: slide positions and low register must be read at a glance; MOLA PDF 7: avoid over-crowding)  % c154: sf> with the strings' tremolo at 63, so the quotation's only sustained accompaniment does not stay f under trombone 1 while the strings fall to p (Adler part 2 PDF 42-44: the subject in the clear; PDF 50-51, Ex. XI-27: sf>p brass attack introducing a solo)
bSecTuba = { R1*21 | \tag #'score { R1*2 } \tag #'part { \cueDuring #"vcQ" #UP { <>^\markup \tiny "Vc." R1*2 } } |  % c135: cue in the part before the entry after a long rest (MOLA PDF 5: logical, audible cues during long rests)
  aes,,1\p\< \breathe | des,1--\f \breathe |  % c286: breath after 61 (tuba and bass trombone): since c218 61-62 are f, not mf, which is 8.9 s of f in the low register at Largamente 54 on one breath; the tuba and bass trombone use the most air in the brass (Adler part 1 PDF 292: in a loud passage in a slow tempo do not phrase too many notes on one breath; PDF 287 and part 2 PDF 1: wide bore, large mouthpiece; part 2 PDF 8: the tuba "takes a great deal of breath"); the notes are tongued, and the contrabassoon, basses, bass clarinet and Bsn 2 hold the bass through the barline  % c218: f with the horn pairs (see Tbn 2)  % c076: mf with horns f (Rimsky-Korsakov PDF 41: horn marks one degree stronger than trombones and tuba)
  ges,,2-- fes,,2-- | R1*2 | }
bSecTimp = {
  R1*13 | \tag #'score { R1^\markup \small "medium sticks" R1 } \tag #'part { <>-\tweak padding #1.5 _\markup \small "medium sticks" \cueDuring #"vcQ" #DOWN { <>^\markup \tiny "Vc." R1*2 } } |  % c146: medium sticks for the f rolls at 60-62 and 79-81 (Adler part 2 PDF 61, 80, 88: name hard/medium/soft; movement I changes to medium sticks in its tOne)  % c135: cue in the part before the entry after a long rest (MOLA PDF 5: logical, audible cues during long rests)
  aes,1:32\pp\< |
  des4\p r4^\markup \small \italic "damp" r2 | R1*5 |  % c214: D flat3 stroke damped on b2, before the cellos' C3 (V6) at b3 (Adler part 2 PDF 80: show how long a note may ring)  % c173: the roll on the dominant A flat2 ends with its stroke on D flat3 (with the cellos), so theme B's return at 53 stands on a root-position tonic, not on A flat under the D flat chord (A&S PDF 235-236: the return from a key area leads to a root-position I; Adler part 2 PDF 79: the timpani strengthen the tonic and dominant bass notes)
  R1 | aes,2.:32\p\<~ aes,8\f r8 |  % c056: roll ends on a tied stroke with a target dynamic (Adler part 2 PDF 80, Ex. XII-47)
  des1:32\f | des4.:32~ des8 r2^\markup \small \italic "damp" | R1*2 |  % c146: D flat damped at 62 b3 under the F flat chord, before the A minor C natural at 63 (Adler part 2 PDF 58, 80)  % c099: no A flat2 (G sharp) roll under the F flat (E) chord at 62 b3: a major third F flat2-A flat2 below the brass/bass fundamentals (Casanelles PDF 274: the third enters the series only at partials 4-5; PDF 275: the drum's partly inharmonic spectrum)  % c084: f, not ff, level with the horns (c069 finding 4; Casanelles PDF 290: a sustained, constant-level sound is perceptually more present and thicker than a struck one; Adler part 2 PDF 184)  % c056: A flat (= G sharp) roll ends and is damped before the A minor downbeat at 63 (Adler part 2 PDF 58, 80)
}

% c300: MIDI only (nothing printed): at 63 the strings' and bass trombone's sf > p is a diminuendo on one held note (tremolo renders as a held note), so score.midi kept
% the sf velocity (Vln 83, Vc 75, Vla and B.tbn 62) under the whole of trombone 1's quotation of movement I's P head; CC11 steps 0.85-0.72-0.6 on beats 2-4 and returns to
% 1.0 at 64, where the p attacks arrive (as the c228 fade at 91). Tagged 'score so the parts' spacing is unchanged. Sebesky PDF 240-241: the red-pencil comparison of score and recording; PDF 13-14: the quotation is the focus
bSecVlnOne = {
  R1*8 |
  R1*4 | R1 | \tag #'score { R1*2 } \tag #'part { \cueDuring #"corAnglaisQ" #UP { <>^\markup \tiny "C.a." R1*2 } } | r2 r4 c''4(\p^\markup \italic \override #'(baseline-skip . 2.4) \column { "senza sord., sul A," "cantabile" } |  % c158: the theme's first string statement is marked to sing; the horn counter-line already has "espr." (Sebesky PDF 13-14: focus on the primary element; PDF 17-18)  % c071: pickup C5-F5 (rising fourth), as flute 1 at 36-37
  % c041: 45-47 theme B head to oboe 1; the first violins rest 37-52 and re-enter fresh at 53
  f''2\< ges''8 f''8 es''4) | des''4( c''8 des''8 es''2)\mp | ges''4(\< \tuplet 3/2 4 { f''8 ges'' f'' } es''4 des''4) | c''4(\mf des''8 c''8 bes'2) |
  % c198: 58 the crescendo from 57 peaks on the suspended G flat (b4, the 4 over D flat) and a short diminuendo takes the resolution F into the breath; 59 f as before; the 58 b4/b4.5 dynamics are hidden, for score.midi only (without them the crescendo overshot the f of 59). Bar 42's 4-3 is shaped the same way (c098). A&S PDF 348: 'dissonant suspensions receive something of an accent and their resolutions are softer'; PDF 357 Ex. 21-17 (Mozart K. 378): cresc. into the 7-6 chain, p where it starts, so the chain is not inside a running crescendo
  aes''4(\<^\markup \italic "ord." des'''4) f'''4.( ges'''8 | aes'''4.) ges'''8(~ ges'''4~ ges'''8-\tweak stencil ##f \f \> f'''8)-\tweak stencil ##f \mf | es'''4.(\f f'''8 des'''4 bes''4) | c'''1\upbow\< |  % c085: 59 in one bow, so the crescendo at 60 is an up-bow and the ff at 61 a down-bow (Adler part 1 PDF 38: crescendo natural on the up-bow; Ex. II-20 Coriolanus, bowing arranged so the accented attack is down-bow)  % c151: 58 rhythm as Fl 1
  des'''2~--\ff\downbow^\markup \italic "molto sostenuto" des'''2\upbow |  % c118: bow change on the tie (Adler part 1 PDF 38, Ex. II-20 Coriolanus), so 62 is D U and the sf at 63 is a down-bow with Vln II and Vc
  f'''2-- <fes''' aes'''>2--^\markup \italic "div." |  % c175: one-stem chord, as Adler part 1 PDF 31 Ex. II-12 writes div. (the lower voice's down-stem tenuto stood alone mid-staff)  % c059: non div. at the ff arrival (Adler part 1 PDF 152: divisi weakens the first violin line); the held A flat6 goes to flute 1  % c051: div. at the ff arrival: the upper half holds A flat6 (fifth of D flat, ninth of G flat, third of F flat) above the augmented head, so the B section's registral peak falls on its held climax and not on the passing eighth B flat6 at 58 (Sebesky PDF 223; c031 option, but held: B flat6-A flat6 here doubled horn 3 and trombone 1's A flat-B flat in octaves and pre-empted the B flat6-A flat6 of 79-80). The lower half keeps D flat6 on the downbeat, so the leading tone C6 of bar 60 still resolves in its own line (c039); A flat5 and F5 stay in Fl, Ob, Cl, Vln II
  << <e''' a'''>1:32\sf\>^\markup \italic "trem." \tag #'score { s4 \set Staff.midiExpression = #0.85 s4 \set Staff.midiExpression = #0.72 s4 \set Staff.midiExpression = #0.6 s4 \set Staff.midiExpression = #1.0 } >> | e'''2:32\p^\markup \italic "unis." r2 |  % c175: chord, as at 62 b3   % c052: the upper half's A flat6 (= G sharp6, leading tone of A minor over F flat = E) rises to A6 instead of leaping a diminished 4th to E6 (A&S PDF 406-407, 439)  % c024: double stop fills the upper octave of the tutti chord (Rimsky-Korsakov appendix PDF 505: violins in 2-4-note chords at the top)  % c034: top note on the theme's A flat5-D flat6 with the flutes, so the upper octave of the augmented head is in the same instruments for all four notes (Adler part 2 PDF 151, Mozart 40/iv); c024's F5-D flat6 kept on beat 3
}
bSecVlnTwo = {
  <des' aes'>1\pp\strMark "D" \markup { "Poco più mosso (" \fontsize #-2 \general-align #Y #DOWN \note {4} #1 "= 60)" }^\markup \italic "senza sord., div., sul tasto" | <des' bes'~>2 <ges' bes'~>2 | <des' bes'>2 \unisHead ges'2 | <es' ges'>2 <des' f'>2 |  % c142: 39 b3-4 both halves on G flat4 (was B flat4 over G flat4): B flat4 doubled the viola's B flat3, the 7th of the half-diminished seventh on C, and left it by a leap; the 7th now sounds once and passes to the bass's A natural (A&S PDF 399, 406-407, 439 item 3)  % c141: top A flat4 at 37 and B flat4 tied through 38-39 (was F4, G flat4 throughout), lower half D flat4-G flat4 under it (was D flat4-B flat3, D flat4-E flat4): the held chord no longer sounds the flute's F5, G flat5 and E flat5 an octave below on the beat (only the D flat at 38 b1 is left); its top line A flat-B flat-G flat-F now has a shape of its own and takes chord tones the melody and bass lack (Sebesky PDF 210-212, Ex. 277, 279-280; PDF 219: the flute's weak register is not covered). Pitches only, from the viola arpeggio's chord: no new figure or colour (c124 rule)
  % c027: Vln II tacet 41-44 when the cor anglais takes theme B's lower octave: its chord (B flat3-G flat4) lay on the cor anglais'
  % own notes (D flat4 at 41, F4 at 42, D flat4 at 43, C4 at 44) and repeated the viola triplets' harmony (Adler part 2 PDF 274:
  % keep the accompaniment registrally distant from a woodwind soloist; the same reason c021 gave for keeping the cor anglais out of 37-40).
  R1*4 |
  f'1\pp\upbow\strMark "E" \markup \null ^\markup \italic "unis., ord." | f'2 ges'2\< |  % c186: 45 up-bow, so the crescendo at 46 b3 is an up-bow and the fp at 47 a down-bow at the frog, as the cellos (c118) (Adler part 1 PDF 38)  % c044: F4/G flat4, not D flat4: the held note no longer sits on the cellos' theme head D flat4 at 45 and 46 b3 (Adler part 2 PDF 159 rule 1, PDF 165: unison doubling of a harmony note with the melody loses its colour)
  \after 2 -\tag #'score ^\markup \italic "poco rit." \after 2. \pp eis'1\fp\> | fis'2-\tag #'score ^\markup \italic "poco sostenuto" fis''2 | a''2 g''4( eis''4) |  % c262: notes unchanged; with the bass now moving to B on b3 (see bSecVc), A5 is the third of i and of VI6 (b2) and steps to G5 with the bass, no longer a 7th made by a held bass on the weak beat  % c202: 49 b1-2 A5 (was F sharp5): the F sharp minor tonic at 49 b1 had no third on the beat (F sharp in four octaves; A only in the violas' off-beat pp eighths); A5 exchanges with the cor anglais' A4-F sharp4 (48-49), becomes the 7th of iv7 over the B at b2 and falls to G5 at b3 (7-6 over the stationary B), then E sharp-F sharp as before (A&S PDF 59-61: the third fixes the triad's quality and the mode's colour; PDF 67-68: the 7th resolves down by step; PDF 65: 5-6 / 7-6 over a stationary bass in one voice)  % c186: G5-E sharp5 on one bow, so 52 b4 is still an up-bow pickup with Vln I after the 45 up-bow  % c059: the leading tone E sharp4 of 47 resolves to F sharp4 in place; the octave shift waits for 48 b3, under the cor anglais' held A4  % c054: 48-52 an octave higher, clear of the cor anglais quotation (unison F sharp4 at 49; Adler part 1 PDF 241-243)  % c048: tempo words above the strings while Vln I rests (c045 practice)
  fis''4( a''4) d''2 | es''1 | f''2\< es''4 c''4(\p^\markup \italic \override #'(baseline-skip . 2.4) \column { "sul A," "cantabile" } |  % c322: 52 b1-2 F5, upper neighbour of E flat5 over the A flat pedal (A&S PDF 553, Ex. 30-19: 6 as diatonic neighbour of 5), with Vc D3  % c071: pickup with Vln I  % c032: D4 at 50 b3 removes the F sharp4/B1 to E flat4/A flat1 fifths and the F sharp-E flat augmented 2nd (A&S PDF 266-267). c027: 49 held through b2-3, so only the bass moves with the oboe's D5 (Adler part 2 PDF 279: Bizet keeps the accompaniment rhythmically apart from the solo)  % c274: 50 b2 A5 (was F sharp5 held): the third of the F sharp minor tonic on a beat, not only in the violas' off-beats (Rimsky-Korsakov appendix PDF 505-507: every group's chord complete; Adler V-32 on-off accompaniment keeps the chord in the sustained parts)
  f''2\< ges''8 f''8 es''4) | des''4( c''8 des''8 es''2)\mp | ges''4(\< \tuplet 3/2 4 { f''8 ges'' f'' } es''4 des''4) | c''4(\mf des''8 c''8 bes'2) |
  % c198: 58 the crescendo from 57 peaks on the suspended G flat (b4, the 4 over D flat) and a short diminuendo takes the resolution F into the breath; 59 f as before; the 58 b4/b4.5 dynamics are hidden, for score.midi only (without them the crescendo overshot the f of 59). Bar 42's 4-3 is shaped the same way (c098). A&S PDF 348: 'dissonant suspensions receive something of an accent and their resolutions are softer'; PDF 357 Ex. 21-17 (Mozart K. 378): cresc. into the 7-6 chain, p where it starts, so the chain is not inside a running crescendo
  aes'4(\<^\markup \italic "ord." des''4) f''4.( ges''8 | aes''4.) ges''8(~ ges''4~ ges''8-\tweak stencil ##f \f \> f''8)-\tweak stencil ##f \mf | es''4.(\f f''8 des''4 bes'4) | c''1\upbow\< |  % c085: as Vln I (Adler part 1 PDF 38)  % c119: 58 holds A flat5 with Ob 1 (see c110)  % c151: 58 rhythm as Fl 1
  aes'2--\ff^\markup \italic "molto sostenuto" des''2-- | \once \override TextSpanner.bound-details.left.text = \markup \italic "sul A" \once \override TextSpanner.bound-details.right.text = \markup \draw-line #'(0 . -1) f''2--\startTextSpan << fes''2-- { s4 s8. s16\stopTextSpan } >> % c305: sul A line ends after F flat5 at 62, not on the E5-C6 chord at 63 (Gould PDF 44)
  | << <e'' c'''>1:32\sf\>^\markup \italic "non div., trem." \tag #'score { s4 \set Staff.midiExpression = #0.85 s4 \set Staff.midiExpression = #0.72 s4 \set Staff.midiExpression = #0.6 s4 \set Staff.midiExpression = #1.0 } >> | <e'' c'''>2:32\p b4(\>^\markup \italic "sul G" d'4 |  % c281: sul A for F5-F flat5 at 62, so the F flat that bends theme B's augmented head toward A minor is a stopped, vibrated note on the same string as the F, not the open E (Adler part 1 PDF 73-74: open strings stand out in slow expressive passages; PDF 75-76: mark sul A to keep a lyrical line on one string)  % c083: B3 on 64 b3 completes the diminished seventh G sharp-B-D-F (= A flat-C flat-D-F, vii°7 of V in A flat), so the last chord of the B section is a full pivot chord and not a root-position diminished triad D-F-A flat with D four times (A&S PDF 243: VII 5/3 seldom satisfactory, the missing 6th supplied; PDF 231: one chord, two meanings); D4-D flat4 slip into 65 unchanged
}

bSecVla = {
  \stemDown % c015: one stem direction for the triplet figure (Gould PDF 38-39)
  \override Beam.damping = #2 % c105: a three-note group slopes at most one stave-space (Gould PDF 33-34)
  \tuplet 3/2 4 { aes8(-\tag #'score \pp -\tag #'part -\tweak extra-offset #'(-0.9 . 0) \pp ^\markup \italic "senza sord., unis." des' f' des' aes des') } \tuplet 3/2 4 { aes8( des' f' des' aes des') } |
  \omit TupletNumber % c035: numbers on the first bar of each figure only (37, 53, 59); the slurred groups make the rhythm plain after that
  \tuplet 3/2 4 { bes8( des' ges' des' bes des') } \tuplet 3/2 4 { bes8( es' ges' es' bes es') } |  % c052: ii6 (bass G flat), not V7 -> ii7
  \tuplet 3/2 4 { bes8( des' ges' des' bes des') } \tuplet 3/2 4 { bes8( es' ges' es' bes es') } |
  \tuplet 3/2 4 { c'8( es' ges' es' c' es') } \tweak TupletNumber.stencil #ly:tuplet-number::print \tuplet 3/2 4 { bes8(\upbow des' f') } r4 |  % c066: beat 4 rest and an up-bow ending at the frog, so the violas have a beat to change from arco to pizz. at 41 (Adler part 1 PDF 54)
  % c057: 41-44 pizz. The cor anglais' lower octave of theme B (A flat3-B flat4) lies in the triplets' own register and attacks their pitches
  % (A flat3, D flat4 at 41; E flat4, D flat4 at 43; C4 at 44): plucked notes decay and leave the solo's held tones alone (Sebesky PDF 13: focus,
  % the background must not divert the ear from the primary element; Rimsky-Korsakov PDF 140: figures to pizz. strings and harp). Arco again at 45.
  \undo \omit TupletNumber \tuplet 3/2 4 { des8\pp\<^\markup \italic "pizz." f aes f des aes } \tuplet 3/2 4 { ges8 bes des' ges bes des' } | \omit TupletNumber  % c267: 41 b1-2 D flat3-F3-A flat3-F3-D flat3-A flat3 (was A flat3-D flat4-F4-D flat4-A flat3-D flat4): the pizz. struck the cor anglais's A flat3 and D flat4 in unison on the very beats it attacked them, at the bottom of its range (Adler part 2 PDF 274: keep a simple accompanying figure registrally apart from a woodwind soloist; PDF 275: the lowest fifth lightly accompanied); D flat3 is the cellos' own arco note, as c108 lowered b3-4; the group ends on A flat3 and steps to G flat3 at b3 (an ending F3 would move in octaves with the basses F-G flat)  % c195: numbers again on the first pizz. bar: c035 omitted them after 37 because the slurs show the grouping, but 41-44 have no slurs and 41 opens a system (score) and a line (part)  % c108: G flat3-B flat3-D flat4 under the cor anglais's F4 appoggiatura (was B flat3-D flat4-G flat4: the resolution G flat4 sounded in the melody's octave before it resolved; Rimsky-Korsakov PDF 132-133)  % c038: shares the cor anglais/flute swell 41-44 (Dvorak 9/ii Largo strings bars 15-16)
  \tuplet 3/2 4 { aes8\p\> des' f' } \tuplet 3/2 4 { bes8 des' ges' } \tuplet 3/2 4 { aes8 es' aes } \tuplet 3/2 4 { aes8 des' aes } |  % c282: 42 b3 A flat3-E flat4-A flat3, the shape of b4 (was A flat3-C4-E flat4): the triplets' middle notes C4-D flat4-B flat3 (42 b3 to 43 b1) doubled the cellos' tenor C3-D flat3-B flat2 at the octave, so the chain's leading tone was doubled and resolved in octaves into the I at 42 b4 (A&S PDF 267 and 286 item 2a: a doubled leading tone is acceptable only when it does not come just before the goal tonic; PDF 267: octaves are the risk when the voices repeat a pattern). The cellos keep the only C; no F sounds against the cor anglais's suspended G flat4  % c267: 42 b4 last note A flat3 (was F4): F4 came a sixth of a beat after the cor anglais's own resolution G flat4-F4 at b4.5, in its octave, the one near-unison with the solo left in 41-44 (Adler part 2 PDF 274); A flat3 steps to the G flat3 at 43
  \tuplet 3/2 4 { ges8 bes des' bes ges bes } \tuplet 3/2 4 { es8 aes es } \tuplet 3/2 4 { es8 ges aes } |  % c221: 43 b3-44 under the cor anglais (was A flat3-E flat4-A flat4 | A flat3-C4-E flat4 | G flat3-C4-E flat4 over its D flat4, B flat3, C4): the pizz. figure no longer crosses above the solo; 6/4 to V7 with 8-7 (A flat-G flat) in the violas, 6-5 (F-E flat) in flute 1 alone (a viola F3 made octaves with it) and 4-3 (D flat-B flat-C) in the cor anglais; still no D flat in the violas at 43 b3 (c192) (Rimsky-Korsakov PDF 139: harmony in the soloist's own register covers it; PDF 137)  % c192: 43 b3 A flat3-E flat4-A flat4 (was A flat3-D flat4-E flat4): the 4th D flat of the cadential 6/4 sounds once, in the cor anglais; the bass is the doubled tone (A&S PDF 154 sec. 5, Ex. 10-5; PDF 160 Points 4: never double the 4th)
  \tuplet 3/2 4 { es8\pp ges aes ges es ges } r2 |  % c219: 41-44 pp < p > pp, one level under the cor anglais (p < mp > p) in its low register (Adler part 2 PDF 274, 267, 275)
  % c042: 46 b3 B flat3, so B flat3-B3-A3 is one voice (no B flat2 bassoon / B3 viola split; A&S PDF 394, Ex. 23-12) and the 7th of C sharp7 is prepared
  \stemNeutral \revert Beam.damping f1\pp^\markup \italic "arco" | des2( \once \override Staff.DynamicLineSpanner.staff-padding = #3 bes2)\< |  % c325: arco resumes down-bow from the frog where the pizz. left the hand; 46 one up-bow crescendo, 47 fp down-bow kept (Adler part 1 PDF 54, 38)
  \tag #'part { \once \textLengthOn } b1\fp\>-\tag #'part _\markup \with-dimensions #'(0 . 20) #'(0 . 0) \null |  % c276: part only: an empty 20-space text widens bar 47 so "poco rit." (47 b3) and "poco sostenuto" (48) print side by side on one line by their own system, not stacked under the system above (c275 open item; MOLA PDF 8, Ex. 7)
   % c167: 46 b1-2 D flat3 (was F3): the B flat minor chord under the melody's B flat-A-B flat had no third for two beats (Sebesky PDF 144-145: the chordal third present somewhere in the ensemble; A&S PDF 76: the third is never omitted except for special effects); F stays in Vln II  % c155: the pp at 48 sat on the first eighth's tenuto-staccato (Gould PDF 55: no characters collide, at least half a space apart)  % c186: arco on an up-bow, so 46 b3's crescendo is an up-bow and 47's fp a down-bow (Adler part 1 PDF 38)
  % c107: 48-51 off-beat eighths on the same pitches under the cor anglais quotation, sotto voce (Adler part 1 PDF 158, Ex. V-32: on-off beat
  % accompaniment in an Adagio; PDF 160-161, Ex. V-36: the strings support the soloist, who 'can execute her part without orchestral interference';
  % PDF 135, 144 rule 4: background rhythmically unlike the foreground). Off-beats are not the quotation's rhythm (c027's reason); 48 b4 rests under the C.a.'s G sharp.
  r8 a8-_\pp -\tag #'score ^\markup \italic "sotto voce" -\tag #'part _\markup \italic "sotto voce" r8 a8-_ r8 a8-_ r4 | r8 a8-_ r8 a8-_ r8 b8-_ r8 gis8-_ | r8 a8-_ r8 a8-_ r8 d'8-_ r8 b8-_ | r8 es'8-_ r8 es'8-_ r8 es'8-_ r8 es'8-_ | \after 2. \p c'1\< |  % c027: 49 A held over the B (iv7), so the upper strings do not move in the quotation's rhythm  % c235: untagged (it printed in the score and the part already; the score viola staff now filters part-only marks)  % c274: 51 off-beats E flat4 (was C4): the cellos now hold the third C3, so the leading tone is not doubled; Vc C3 / Vla E flat4 at 51 exchange to E flat3 / C4 at 52  % c285: part only: "sotto voce" below the staff, so "poco sostenuto" (48) prints beside "poco rit." instead of stacked over it under the system above (MOLA PDF 8, Ex. 7)
  % c049: 53-56 the triplet figure goes to the harp and the violas rest, re-entering at 57 with the crescendo (Rimsky-Korsakov PDF 140: figures
  % of the accompaniment "better partially entrusted to pizz. strings and harp", which have "little chance of overpowering"; PDF 138: a sustained
  % or bowed line covers a melody more than short detached notes; Ex. 289-291, PDF 144 and PDF 118: a repeated idea is rescored by altering
  % details). 37-40 and 53-56 no longer have the same accompaniment, and the build is staged: harp 53, violas 57, sextuplets 59.
  \tag #'part { \once \override Score.MetronomeMark.extra-offset = #'(0 . -0.5) } R1*4 |  % c276: part only: "a tempo, poco a poco animando" must clear the 53-56 bar range, and once bar 47 was widened (above) it touched the tenuto marks of 49 on the system above; half a space lower it clears both
 
  \undo \omit TupletNumber
  \stemDown \override Beam.damping = #2 \tuplet 3/2 4 { aes8(-\tag #'score \mp -\tag #'part -\tweak extra-offset #'(-0.9 . 0) \mp \< des' f' des' aes des') }  % c069: mp, not mf: the figure enters under Fl/Ob p< and violins mf (Adler part 2 PDF 159 rule 1; PDF 184)
   \omit TupletNumber \tuplet 3/2 4 { bes8( des' bes' des' bes des') } |
  \tuplet 3/2 4 { aes8( bes des') } \tuplet 3/2 4 { bes8( des' ges') } \tuplet 3/2 4 { aes8( c' aes') } \tuplet 3/2 4 { aes8( ces' aes') } |  % c277: 57 b3-4 and 58 revoiced so the triplets no longer re-strike the Hn 1 counter-line's held G flat4 (57), F4, E flat4, F4 (58); was bes8 des' ges' (57 b3-4), aes des' f' / aes c' es' / aes ces' f' (58 b1, b3, b4) (Adler part 2 PDF 203, 217, 230 item 3; as c137 for the harp at 53-56)  % c013: V7/IV at 58 b4 (A&S PDF 444-445)
  \undo \omit TupletNumber
  \tuplet 6/4 4 { ges16(\f bes es' bes ges bes) es'( bes ges bes es' bes) } \tuplet 6/4 4 { bes16( des' es' des' bes des') fes'( des' bes des' fes' des') } |  % c029: figure doubles its speed for the last two bars of the animando (Rimsky-Korsakov Ex. 168, PDF 337-338; Ex. 153, PDF 325-328)  % c085: six notes per bow (one beat) at f, not twelve (Adler part 1 PDF 39, Ex. II-22: Mendelssohn's violas six to a bow at forte; slow tempo, do not overload the bow)
  \omit TupletNumber
  \tuplet 6/4 4 { aes16(\< c' es' c' aes c') es'( c' aes c' es' c') } \tuplet 6/4 4 { ges16( c' es' c' ges c') \once \override Beam.damping = #6 ges( c' es' ges' es' ges') } |  % c029: last note G flat resolves to the F of the 61 double stop (no C-D flat octaves with Vln I)
  \undo \omit TupletNumber
  \stemNeutral \revert Beam.damping <des' f'>1:32\ff^\markup \italic "non div., molto sostenuto, trem." | <bes des'>2:32 <aes fes'>2:32 | << <e' c''>1:32\sf\> \tag #'score { s4 \set Staff.midiExpression = #0.85 s4 \set Staff.midiExpression = #0.72 s4 \set Staff.midiExpression = #0.6 s4 \set Staff.midiExpression = #1.0 } >> | <e' c''>2:32\p gis2(\>^\markup \italic "sul C" |  % c096: "sul C" where the slurred G sharp3-G3 begins, not on its second note at 65 (Adler part 1 PDF 64: the string must be marked where the passage on it starts)  % c099: 62 b3 A flat3/F flat4, not C flat4/F flat4: C flat4(B3)-E4 over the bass E-A made parallel fifths at 62-63 (introduced by c094; c032 had removed the same fault). F flat4 is held into 63 as the common tone.  % c094: E4-C5, not C4-E4: out of trombone 1's quotation (E3-C4, its C4 on 63 b1.5 was a unison with the violas) and into the empty E4-E5 octave under Vln II's E5-C6 (Rimsky-Korsakov PDF 86: no wide empty intervals between upper and lower parts in forte; PDF 85: close intervals at the top; PDF 88: forte tremolo on two strings may take the easiest intervals). The D string keeps F flat4 = E4 from 62; the G string's C flat4 moves to C5 on the A string
   % c032: C4-E4 at 63-64 (was E4-A4: fifths and octaves with the bass E-A). c019: 61-64 double stops, not divisi (Rimsky-Korsakov PDF 88)
}

bSecVc = {
  % c079: rests 37-40 (was des4\p pizz. r4 des4 r4 | bes,4 r4 ges,4 r4 | es4 r4 des4 r4 | a,2 bes,2): the pizzicato bass was in three parts on two
  % pitches (Vc D flat3 = harp LH upper note, Cb = harp LH lower note). The basses and harp keep the steady pizzicato bass; the cellos enter arco
  % at 41 as an independent part, fresh after a rest (Adler part 2 PDF 205, Brahms Hungarian Dance 1: "the steady pizzicato bass and the independent
  % cello part"; PDF 228, Stravinsky: a colour rested so its entrance is fresh; PDF 213, Dvorak: a delayed entrance clarifies).
  R1*4 |
  % c037: 41-44 the cellos leave the pizzicato bass (basses + harp keep it) and hold a slow arco tenor line under the cor anglais:
  % the sustained "harmonic counterpoint" under a soft melody and light accompaniment (Adler part 2 PDF 209, Dvorak Slavonic Dance 8),
  % the held residue of the viola arpeggio (PDF 230, Schoenberg-Brahms item 2) and a cello part independent of the pizzicato bass
  % (PDF 205, Brahms Hungarian Dance 1). D flat3-E flat3 lies below the cor anglais (A flat3-B flat4), the register c027 cleared of Vln II.
  des1\pp\<\upbow^\markup \italic "senza sord." | \once \stemUp des4(\p\> bes,4 c4 \once \stemUp des4) | bes,2(\pp aes,4 c4 | es2) r4 aes4(\pp^\markup \italic "sul D" |  % c245: bass clef throughout 44-47 (was tenor 44 b4-47): the line goes no higher than E flat4, two ledger lines; Gould PDF 21: stay in one clef up to at least three ledger lines (the cellos keep bass clef for the same E flat4/D flat4 at 79-80)  % 42: contrary motion to the cor anglais and flute on every beat; no doubled seventh with the violas  % c085: the whole note takes its own bow; the eight-beat slur was a phrase slur (Adler part 1 PDF 38: no long phrase slurs in string parts; PDF 39: cello bows are shorter)  % c118: 41 up-bow, so the swell 41-42 is up-bow crescendo, down-bow diminuendo (Adler part 1 PDF 38)  % c262: 43 b3 A flat2 (was E flat3): the cadential 6/4 doubles its bass instead of sounding its 5th under the flute's 6th F5 (A&S PDF 153 sec. 2: the 6th delays the 5th of V; PDF 154 Ex. 10-5a: bass doubled 'good'); C3 on b4 kept (c222)
  % c011: cellos in octaves below Vln I on the A and D strings (Rimsky-Korsakov PDF 56, 60-61, Ex. 29-30); bass to Bsn 2 + Cb.
  des'2 es'8 des'8 c'4) | bes4( a8 bes8) des'2\< | cis'2.\mp\> r4\! | cis1\pp^\markup \italic "ord." | fis2 b,2 | a,2 b,2 | c1 | d2\< es2 |  % c322: 52 b1-2 D3 (was E flat3 whole): C3-D3-E flat3 passing sharp-4 of the A flat pedal, with Vln II F5 the chord A flat-C-D-F (bar 86's sonority) rising into A flat7 (A&S PDF 554, Ex. 30-20d; PDF 556, Ex. 30-23)  % c124: pp < mp, one level under oboe 1, so the oboe octave, not the cello section, is heard as theme B's head (Adler part 2 PDF 150-151, Mozart 40/iv: the more heavily scored octave is heard as the theme)  % c042: E flat3, not a second G flat (the 7th) that leapt to D flat3 at 53; the cor anglais' A flat-G flat-F is the passing 7th and its resolution (A&S PDF 375, 377)  % c118: 46 des'2 its own up-bow for the crescendo, 47 down-bow for the diminuendo (Adler part 1 PDF 38)  % c262: 49 bass F sharp2 (half) - B (b3) - C sharp (b4), was F sharp - B (half, b2-3) - C sharp: the chord changed on b3 over a bass held from the weak b2 (iv7 to N6, A&S PDF 149 Ex. 9-24a 'poor', PDF 151 Points 9); now i - VI6 (5-6 over the held F sharp, strong to weak) - N6 on b3 with the bass - V, and the cor anglais' D5 alone carries the syncopation  % c274: 51 C3 (was E flat3): the A flat7's third sustained on the beat in the strings (Rimsky-Korsakov appendix PDF 505-507; ch. IV PDF 116)
  \once \stemUp des2\p\< c2 | bes,2 ges,2\mp | es,2\< c,2 | a,2\mf bes,2 |  % c257: 55 b3 C2 (was C3): bassoon 1's 7th D flat3 resolves to C3 here, and the cellos leapt E flat2-C3 into unison with it, so the background line merged with the bass for two beats; C2 keeps the bass a separate element an octave below (Adler part 2 PDF 176, 179) and follows the bass of 39 (E flat2-C2)
   % c201: 55 b1-2 E flat2 (was E flat3): bassoon 1's held D flat3 lay a second below the cellos' E flat3, so the lowest sounding note was the 7th and the theme's G flat5 stood a 4th above it (A&S PDF 40-41: the 4th against the lowest part is dissonant; PDF 39 sec. 9); the root now lies under the 7th, as the basses' E flat2 at 39
  % c017: cellos double horn 1's counter-line an octave lower from 57 b3 (b1 stays on the bass: no B flat-A flat octaves with Vln I at 56-57) (Adler PDF 177-178: Meistersinger, cellos with Horn I); bass to B.cl., Bsn 2, Cb.
  f2\< ges2(^\markup \italic "espr." | f4) es2(~ es8 f8) | ges2\f es4( fes4) | es4(\upbow\< f4 ges2) |  % c096: 59 in two bows (U, D), so 60 is a plain up-bow; as written 59 (up) and 60 (marked up) were two four-beat up-bows in succession at f (Adler part 1 PDF 37-38: a slur is one bow; Ex. II-19's two up-bows are short notes, not two long bows)  % c089: 58 b4 F3 again (c082's A flat3 made fifths A flat/E flat -> D flat/A flat with the bass; A&S PDF 352: resolution tone an octave lower in a contrasting timbre is acceptable)  % c082: 60 b4 anticipation  % c085: up-bow crescendo into the ff down-bow at 61 (Adler part 1 PDF 38, two up-bows as in Ex. II-19)  % c151: 58 b4 E flat3 held to b4.5, as Hn 1  % c172: 60 b3-4 G flat held (was G flat4. F8): the F anticipation sounded a semitone under trombone 2's G flat3 and the violas' G flat4 in the same octaves; the 7th now resolves at 61 in Tbn 2, Bsn 1, Hn 2 and the violas (A&S PDF 469, 475; Ex. 27-6a)
  aes2--\ff^\markup \italic "molto sostenuto" des'2-- | f'2-- fes'2-- | << a,1:32\sf\>^\markup \italic "trem." \tag #'score { s4 \set Staff.midiExpression = #0.85 s4 \set Staff.midiExpression = #0.72 s4 \set Staff.midiExpression = #0.6 s4 \set Staff.midiExpression = #1.0 } >> | a,2:32\p d,4( b,8 bes,8) |  % c232: 64 b4.5 B flat2 anticipated (A&S PDF 507, Ex. 29-11: an anticipation of 2 over the German sixth gives a momentary French sixth, the usual way to avoid its fifths; PDF 506 Ex. 29-9, PDF 524-525 sec. 14): E2-B2 -> E flat2-B flat2 were open fifths in the two lowest voices of the pp four-part string texture  % c210: 64 b4 B2 (C flat3), so E2-G sharp3-B2-D4 is a complete German sixth of A flat (= V7 of A minor, the flat II), and C flat-B flat falls a semitone into 65 (A&S PDF 524, 526)  % c097: D2-E2, not D3-E3: the cellos' E3 on 64 b4 sounded the tone of resolution of trombone 1's F3 (a 9-8 over the bass E) in the same octave, a semitone under it, before the trombone resolved; in the bass octave it is the allowed 9-8 case (A&S PDF 352; Adler part 2 PDF 42: the quoted line must come through)
   % c074: tremolo A2, not A3: A3 lay inside trombone 1's quotation (E3-C4), in unison with its A3 and a semitone from its B flat3/G sharp3 (Adler part 1 PDF 144: theme and accompaniment separated registrally; PDF 161, Ex. V-37: Bizet's tremolo kept clear of the tune's register)
}
bSecCb = {
  des,4\p^\markup \italic "pizz." r4 des,4 r4 | bes,,4 r4 ges,,4 r4 | es,4 r4 c,4 r4 | a,,2 bes,,2 |
  f,4 f,4 ges,4 ges,,4 | bes,,4 es,4 aes,,4 \once \stemUp des,4 | ges,,4 bes,,4 aes,,4 aes,,4 | aes,,4 r4 r2 |  % c239: 41 and 43 pizz. on every beat (was f,4 r4 ges,4 r4 | ... | ges,,4 r4 aes,,4 r4), so the quarter-note bass of 42 runs through the cor anglais phrase 41-43 instead of standing alone: the second phrase of the più mosso gains a moving bass while 37-40 keep the plain halves with the harp (Dvorak 9/ii: basses silent under the più mosso tune 46-53, pizz. in continuous eighths from its second phrase, 54-63; Mozart 41/ii 7-10: the bass moves in eighths from the second phrase; Adler part 1 PDF 235-236, 246-247, 255, Ex. VIII-1, VIII-12, VIII-42: pizzicato bass figures moving under sustained winds). Arpeggiated chord tones only (41 I6 repeated, IV with its root dropped an octave; 43 ii6/5-ii4/3-V: c342, the bass arpeggiates ii7 G flat-B flat under the cor anglais's held E flat4, the 7th D flat4 in the viola figure, so 43 b2 is a 4/3, not a 6/4 (A&S PDF 69-70, Ex. 4-18; PDF 66-67: name chords from the bass)), no 6/4 on a weak beat and no octaves with the viola triplets' top note (a D flat2 at 41 b2 made F-D flat octaves with it); the harp keeps beats 1 and 3  % c122: 43 G flat1/A flat1 (was G flat2/A flat2), so the lower strand of the 42 fifths chain falls B flat1-A flat1-G flat1 as at 58-59 (A&S PDF 267: two stepwise lines, one thrown into relief by register)
  bes,,1\pp^\markup \italic "arco" | bes,,2( ges,,2)\< |  % c325: as the violas (Adler part 1 PDF 54, 38)
  \after 2. \pp cis,1\fp\> | fis,1 | fis,2 b,,4 cis,4 | fis,2 b,,2 | aes,,1 | aes,,1 |  % c186: as Vln II and Vla: crescendo up-bow at 46, fp down-bow at 47 (Adler part 1 PDF 38)  % c262: 49 F sharp2 half, B1 quarter on b3, as the cellos (A&S PDF 149 Ex. 9-24a; PDF 151 Points 9)
  R1*4 |  % c164: basses tacet 53-56 under the first string statement of theme B (cellos alone on the bass, harp triplets, p-mf) and re-enter at 57 where the cellos leave the bass for their counter-line and the tutti build starts (Adler part 1 PDF 130-131, Ex. V-6: -Bass for a lighter texture, +Bass for the build and cadence; PDF 139, Ex. V-16: adding cellos and basses sets off the second statement and prepares the tutti; PDF 137, Ex. V-14: crescendo by added octaves). Was des,2\p\< c,2 | bes,,2 ges,,2\mp | es,2\< c,2 | a,,2\mf bes,,2 (octaves with the cellos); 52 hairpin removed (the basses hold pp and drop out; the cellos keep the swell)
  f,2\mf\< ges,2 | bes,,4 es,4 aes,,4 \once \stemUp des,4 | ges,,2\f g,,2 | aes,,2~\downbow\< aes,,2\upbow |  % c096: the crescendo f-ff is split over two bows with the change on the tie (Adler part 1 PDF 38, Ex. II-20 Coriolanus: down- and up-bow over the long note so the next attack is solid; PDF 39-40, Ex. II-23/24: a crescendo on one long bass bow in a slow tempo is impossible); 61 still on a down-bow  % c085: 59 in one bow, up-bow crescendo at 60, down-bow ff at 61 (Adler part 1 PDF 38)
  % c316: 62 bowed down-up, so the F flat ends at the frog and the players can pluck the 63 sf pizz. at once (Adler part 1 PDF 54: an up-bow just before a pizzicato gives leverage for a quick change; Rimsky-Korsakov PDF 45: bass pizz. is the slowest)
  des,1--\ff^\markup \italic "molto sostenuto, change bow at will" | ges,,2--\downbow fes,,2--\upbow | a,,4\sf^\markup \italic "pizz." r4 r2 | a,,2\p^\markup \italic "arco" d,4 e,4 |
}

% c026: harp doubles the pizzicato bass 37-44 (Adler part 1 PDF 117: harp as a doubling instrument; PDF 113-114: low two octaves dark and sonorous).
% Pedals: G to G flat during the rests 15-36 (diagram at 37); A natural for bar 40 (right foot, during the rest at 39 b4), back to A flat during 40 b3-42 b2;
% G flat back to G natural during 57-70 (c049: after the harp figure at 53-56) (diagram at 71). One pedal per foot at a time (Adler part 1 PDF 112-113).
% c049: 53-56 the harp takes the violas' triplet figure (pitches as the violas had them in v49). Pedals as at 37 (D flat, C, B flat | E flat, F,
% G flat, A flat). No A natural in 53-56 since c137's revoicing, so no pedal change inside the figure.
% c241: pp at 53, p at 55 (was p, mp): never above the Hn 1/Cl 1 counter-line (theme A's head, pp< to mp at 55), which lies in the
% same octave, A flat3-B flat4, the harp's strongest register (Adler part 1 PDF 113-114: middle two octaves rich and warm, ff at the top = mf
% in the middle); Adler part 2 PDF 184: principal and subsidiary voices louder than the figuration (Schoenberg's H/N marks).
bSecHarpR = {
  R1*16 |
  \override Beam.damping = #2 % c105: as the violas' triplets (Gould PDF 34)
  \tuplet 3/2 4 { aes8\pp-\tag #'score ^\markup \small \harp-pedal #"^-^|^-^^" des' f' des' aes des' } \tuplet 3/2 4 { aes8 es' aes' es' aes' es' } |  % c212: 53 b3-4 A flat3-E flat4-A flat4 | E flat4-A flat4-E flat4 (was A flat3-C4-E flat4 | C4-E flat4-C4): over the cellos' C3 the chord is V6 of D flat, and the harp's C4 doubled its leading tone, with neither C resolving to D flat (C3-B flat2, C4-G flat3) (A&S PDF 108 sec. 4: in V6 the leading tone must never be doubled; PDF 109 Ex. 7-5e 'wrong'). No A flat3 on b4 (c137) and the figure still ends on E flat4, not A flat4 (c142).  % c142: 53 b4 ends C4-E flat4-C4 (was C4-E flat4-A flat4): the figure's top A flat4 under the violins' E flat5 went on to G flat3/G flat4 under D flat5 at 54, consecutive fifths into the downbeat (A&S PDF 404, 434-435)  % c137: 53 b4 C4-E flat4-A flat4 (was C4-A flat3-E flat4): no A flat3 on horn 1/clarinet 1's A flat3 pickup, and no A flat3-G flat3 / E flat5-D flat5 fifths with the violins into 54
  \omit TupletNumber
  \tuplet 3/2 4 { ges8 bes ges' bes ges bes } \tuplet 3/2 4 { bes8 es' ges' es' bes es' } |  % c137: 54-56 no harp attacks on the Hn 1/Cl 1 counter-line's held D flat4 (54), G flat4 (55), C4 and D flat4 (56), nor on Bsn 1's G flat3/F3 (56): the figure was the violas' 37-40 figure, written before the counter-line took this octave (Adler part 2 PDF 203: layers in order of importance; PDF 217: like-moving layers need separating; PDF 230 item 3: middle parts not doubled while a solo line runs). Was bes8 des' ges' des' bes des'
  \tuplet 3/2 4 { bes8\p des' es' des' bes des' } \tuplet 3/2 4 { bes8 c' es' es' bes es' } |  % c332: 55 b4 E flat4-B flat3-E flat4 (was C4-B flat3-C4): the harp's C4 was struck with the theme's passing D flat5 and anticipated its resolution C5 at 56 in an inner voice; B1's violas have E flat4 here at 39 b4 (A&S PDF 469-470: the tone of resolution sounding in a voice other than the bass gives an unclear sonority; PDF 475, Ex. 27-16b)  % c137: was bes des' ges' (x2) | bes es' ges' (x2)
  \tuplet 3/2 4 { es'8 ges' es' ges' es' ges' } \tuplet 3/2 4 { bes8 f' bes f' bes f' } |  % c137: was c' es' ges' es' c' es' | bes des' f' des' bes des'
  \undo \omit TupletNumber \revert Beam.damping
  R1*4 | R1*4 |
}
bSecHarpL = {
  <des, des>4\p-\tag #'score ^\markup \small \harp-pedal #"^-^|^-^^" r4 <des, des>4 r4 | <bes,, bes,>4 r4 <ges,, ges,>4 r4 | <es, es>4 r4 <c, c>4 r4-\tag #'score _\markup \small "A♮" | <a,, a,>2 <bes,, bes,>2 |
  <f, f>4 r4 <ges, ges>4 r4-\tag #'score _\markup \small "A♭" | <bes,, bes,>4 <es, es>4 <aes,, aes,>4 <des, des>4 | <ges,, ges,>4 r4 <aes,, aes,>4 r4 | <aes,, aes,>4 r4 r2 |  % c122: 43 an octave lower with the basses
  R1*20 |
}
