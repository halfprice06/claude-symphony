% RETRANSITION, bars 65-70 (Tempo I, 3/4). The E of the A minor bar slips to E flat (V of A flat).
% Horn 1 alone over the double basses' and timpani's E flat: the motto's tail E flat-D-D flat-C to B flat.

retrVlnOne = { R2.*5 | r2 es''8(\mf f''8 | }
retrVlnTwo = { des'2.\pp^\markup \italic "unis." | des'2.\> | R2.*3\! | r2 es'8(\mf f'8 | }
retrVla = { g2.\pp^\markup \italic "unis." | g2.\> | R2.*4\! | }
retrVc = { bes,2.\pp | bes,2.\> | R2.*4\! | }
retrCb = { es,2.\pp~ | es,2.~ | es,2.~ | es,2.~ | es,2.~ | es,2. | }
retrTimp = { R2.*2 | es2.:32\ppp~ | es2.:32~ | es2.:32~ | es2:32 r4 | }
retrHnOne = { R2.*2 | es'2.(\p^\markup \italic "solo" | d'4 des'4 c'4 | bes2.~\> | bes2)\pp r4 | }
retrBsnOne = { R2.*4 | g2.\pp | g2 r4 | }
retrBsnTwo = { R2.*4 | des2.\pp | des2 r4 | }
